<?xml version="1.0"?>
<package format="2">
  <name>dk_search_rviz_panel</name>
  <version>0.1.0</version>
  <description>RViz left-side control panel for UAV 3D search task, main routes and backup routes.</description>

  <maintainer email="user@example.com">cat</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rviz</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pluginlib</depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
